# ScholarSync Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Environment
ENVIRONMENT=development

# Database (PostgreSQL/Supabase)
# Local dev: postgresql://user:password@localhost:5432/dbname
# Production / load testing (required for concurrent classroom use):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Port 6543 = Supabase transaction pooler. Session pooler :5432 exhausts under SSE chat load.
# If .env still uses :5432, connection.py auto-upgrades to :6543 unless DATABASE_FORCE_SESSION_POOLER=1.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Clerk Authentication (backend + scripts read from repo root `.env`)
CLERK_SECRET_KEY=sk_test_***
CLERK_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n***\n-----END PUBLIC KEY-----
CLERK_JWT_AUDIENCE=
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# Admin portal (standalone ops login; change secret in production)
ADMIN_PORTAL_EMAIL=sync@gmail.com
ADMIN_PORTAL_PASSWORD=admin123
ADMIN_PORTAL_JWT_SECRET=dev-admin-portal-secret-change-in-production
ADMIN_PORTAL_USER_ID=admin-portal-sync
ADMIN_PORTAL_TOKEN_TTL_HOURS=24

# Next.js (`apps/web/.env.local`) — publishable key MUST use this name for the browser:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_***
# CLERK_SECRET_KEY=sk_test_***   (same secret as above; required for Clerk middleware / server)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/home

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAI
OPENAI_API_KEY=sk-***

# Google Gemini
GEMINI_API_KEY=***

# Pinecone
PINECONE_API_KEY=***
PINECONE_ENVIRONMENT=***
PINECONE_INDEX_NAME=scholarsync

# AWS S3 (or Supabase Storage)
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_REGION=us-east-1
S3_BUCKET_NAME=scholarsync-files

# Supabase (if using Supabase Storage instead of S3)
SUPABASE_URL=https://***.supabase.co
SUPABASE_KEY=***

# Guided Problem Solver (set true for staging/local)
ENABLE_PROBLEM_SOLVER=false
# apps/web/.env.local
# NEXT_PUBLIC_ENABLE_PROBLEM_SOLVER=true

# LangSmith tracing (optional — sends LangGraph/LLM runs to smith.langchain.com)
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=notebooklm-dev
# Eval project for experiments (override at runtime via eval.py --project)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

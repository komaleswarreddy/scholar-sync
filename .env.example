# ScholarSync Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Environment
ENVIRONMENT=development

# Database (PostgreSQL/Supabase)
# Local dev: postgresql://user:password@localhost:5432/dbname
# Production / load testing (required for concurrent classroom use):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Port 6543 = Supabase transaction pooler. Session pooler :5432 exhausts under SSE chat load.
# If .env still uses :5432, connection.py auto-upgrades to :6543 unless DATABASE_FORCE_SESSION_POOLER=1.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Platform authentication (unified username/password login)
PLATFORM_JWT_SECRET=change-me-to-a-strong-random-48-char-platform-secret
PLATFORM_TOKEN_TTL_HOURS=24
BOOTSTRAP_ADMIN_USERNAME=scombinator
BOOTSTRAP_ADMIN_PASSWORD=notebook123
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Clerk Authentication (deprecated — kept for reference during transition)
CLERK_SECRET_KEY=sk_test_***
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_PUBLIC_KEY=
CLERK_JWT_AUDIENCE=
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# Admin portal (standalone ops login)
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate a bcrypt hash:     python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# In production, set ADMIN_PORTAL_PASSWORD_HASH (preferred) or a strong ADMIN_PORTAL_PASSWORD.
ADMIN_PORTAL_EMAIL=ops@your-domain.com
ADMIN_PORTAL_PASSWORD=
ADMIN_PORTAL_PASSWORD_HASH=
ADMIN_PORTAL_JWT_SECRET=change-me-to-a-strong-random-48-char-secret
ADMIN_PORTAL_USER_ID=admin-portal-sync
ADMIN_PORTAL_TOKEN_TTL_HOURS=24

# Teacher portal (standalone login; same model as admin portal)
TEACHER_PORTAL_EMAIL=teacher@your-domain.com
TEACHER_PORTAL_PASSWORD=
TEACHER_PORTAL_PASSWORD_HASH=
TEACHER_PORTAL_JWT_SECRET=change-me-to-a-different-strong-random-secret
TEACHER_PORTAL_USER_ID=teacher-portal-demo
TEACHER_PORTAL_TOKEN_TTL_HOURS=12

# Next.js (`apps/web/.env.local`) — publishable key MUST use this name for the browser:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_***
# CLERK_SECRET_KEY=sk_test_***   (same secret as above; required for Clerk middleware / server)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/home

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAI (embeddings, reranking fallback, DALL-E images, moderation — NOT primary chat model)
OPENAI_API_KEY=sk-***

# Google Gemini
GEMINI_API_KEY=***

# Groq — primary text-generation provider for chat/RAG/studio/tutor/problem-solver
GROQ_API_KEY=gsk-***
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=openai/gpt-oss-120b

# Pinecone
PINECONE_API_KEY=***
PINECONE_ENVIRONMENT=***
PINECONE_INDEX_NAME=scholarsync

# AWS S3 (or Supabase Storage)
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_REGION=us-east-1
S3_BUCKET_NAME=scholarsync-files

# Supabase (if using Supabase Storage instead of S3)
SUPABASE_URL=https://***.supabase.co
SUPABASE_KEY=***

# File storage backend: "s3" (Supabase Storage, default) or "local" (filesystem, for dev
# without a reachable Supabase project). "local" also needs API_BASE_URL set correctly.
STORAGE_BACKEND=s3
API_BASE_URL=http://localhost:8000

# Guided Problem Solver (set true for staging/local)
ENABLE_PROBLEM_SOLVER=false
# apps/web/.env.local
# NEXT_PUBLIC_ENABLE_PROBLEM_SOLVER=true

# LangSmith tracing (optional — sends LangGraph/LLM runs to smith.langchain.com)
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=notebooklm-dev
# Eval project for experiments (override at runtime via eval.py --project)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

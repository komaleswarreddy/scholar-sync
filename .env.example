# ScholarSync Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Environment
ENVIRONMENT=development

# Database (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_***
CLERK_SECRET_KEY=sk_test_***
CLERK_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n***\n-----END PUBLIC KEY-----
CLERK_JWT_AUDIENCE=
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAI
OPENAI_API_KEY=sk-***

# Google Gemini
GEMINI_API_KEY=***

# Pinecone
PINECONE_API_KEY=***
PINECONE_ENVIRONMENT=***
PINECONE_INDEX_NAME=scholarsync

# AWS S3 (or Supabase Storage)
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_REGION=us-east-1
S3_BUCKET_NAME=scholarsync-storage

# Supabase (if using Supabase Storage instead of S3)
SUPABASE_URL=https://***.supabase.co
SUPABASE_KEY=***

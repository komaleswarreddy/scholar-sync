FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Celery and Redis support
RUN pip install --no-cache-dir celery[redis] redis

# Copy application code
COPY . .

# Run Celery worker
# Note: When celery_app.py is fully implemented, use: celery -A apps.worker.celery_app worker
# For now, this is a placeholder that will work once Celery is configured
CMD ["celery", "-A", "apps.worker.celery_app", "worker", "--loglevel=info"]

